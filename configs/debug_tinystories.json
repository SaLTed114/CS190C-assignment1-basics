{
  "experiment_name": "debug_tinystories_4k_vocab",
  "out_dir": "artifacts/debug_run_v2",
  "data": {
    "train_npy": "artifacts/debug_tinystories/train.npy",
    "valid_npy": "artifacts/debug_tinystories/valid.npy",
    "tokenizer_path": "artifacts/debug_tinystories/tokenizer.pkl",
    "meta_path": "artifacts/debug_tinystories/meta.json"
  },
  "model": {
    "vocab_size": 4096,
