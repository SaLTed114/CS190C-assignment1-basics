  "train": {
    "batch_size": 16,
    "max_steps": 1000,
    "eval_every": 100,
    "eval_steps": 20,
    "log_every": 20,
    "save_every": 200,
    "device": "auto",
    "seed": 42,
    "compile_model": false,
    "num_workers": 0
  }
